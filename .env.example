# ========================================================
# AI-Powered CCTV Surveillance System - Configuration
# ========================================================

# LLM Configuration (Feature 12)
# Supported Providers: groq, openai, gemini, ollama
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.1

# Provide your API Key here (or via request header / UI)
GROQ_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Database Configuration
# Uses local SQLite by default, seamlessly switchable to PostgreSQL
DATABASE_URL=sqlite:///./surveillance.db
# Example for PostgreSQL:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/cctv_surveillance

# Vector Store Configuration
VECTOR_STORE_DIR=./chroma_data
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Re-ID & Vision Configuration (Feature 13)
REID_SIMILARITY_THRESHOLD=0.72
REID_FEATURE_DIM=512
YOLO_MODEL_PATH=yolo11n.pt
REID_BACKBONE=osnet_x0_25
DEVICE=cpu

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=True
