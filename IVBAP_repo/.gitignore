# ── Backend Data & Logs ─────────────────────────────────────────────────────
# Runtime logs
*.log
server.log
server.err.log
backend/server.log
backend/server.err.log
backend/*.log
boot*.log
debug*.log
se*.log
so*.log
srv.*

# Process IDs
*.pid
server.pid

# Database files (runtime generated)
backend/data/*.json
!backend/data/.gitkeep

# Alert logs
backend/data/face_alerts.json

# ── AI Models & Weights ─────────────────────────────────────────────────────
# YOLO weights (large files, download separately)
backend/weights/*.pt
backend/weights/*_openvino_model/
!backend/weights/.gitkeep

# InsightFace models (downloaded at runtime)
*.onnx
*.params
*.bin

# Plate detector model (optional)
backend/models/*.pt
!backend/models/.gitkeep

# EasyOCR models (stored on D: drive)
D:/easyocr-models/

# ── Video Files ─────────────────────────────────────────────────────────────
# Large video files (download separately or use test videos)
*.mp4
*.webm
*.avi
*.mov
!public/.gitkeep

# Allow specific small test videos if needed (uncomment to include)
# !public/test-video.mp4

# ── Training Data ───────────────────────────────────────────────────────────
